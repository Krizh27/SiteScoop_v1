# Dependency directories
node_modules/
*/node_modules/

# Production build outputs
dist/
dist-ssr/
build/
*.local

# Environment files
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor & OS files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Workspace storage (keep directory structure with .gitkeep)
workspace/*
!workspace/.gitkeep
